{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rewind",
  "version": "0.1.2",
  "identifier": "com.rewind.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rewind",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#0E1014"
      },
      {
        "label": "flyout",
        "title": "Rewind",
        "url": "index.html",
        "width": 380,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#15181E"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFNzA0MjU5MzM1OEYxQTUKUldTbDhWZ3pXVUp3amhpZ1hTdVQvMU83TU9QMXNKYW5KNlc4UmtkbjJFR0pmSmg5c0dvZyt2amoK",
      "endpoints": ["https://github.com/aattiaibrahim/Rewind/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../vendor/ffmpeg/bin/ffmpeg.exe": "ffmpeg/ffmpeg.exe",
      "../vendor/ffmpeg/bin/ffprobe.exe": "ffmpeg/ffprobe.exe",
      "../vendor/ffmpeg/bin/*.dll": "ffmpeg/",
      "../vendor/ffmpeg/LICENSE.txt": "ffmpeg/LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "publisher": "Rewind",
    "shortDescription": "Lightweight NVENC replay-buffer clipper",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
